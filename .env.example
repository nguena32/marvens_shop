# Configuration d'environnement — Marvens Shop MVP (cPanel / Dédié)
# Ne jamais committer de mots de passe ou de secrets réels dans ce fichier

APP_NAME="Marvens Shop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=changer_cette_cle_secrete_aleatoire_64_caracteres_min

# Base de données (MySQL 8 / PDO)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marvens_shop
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Paramètres de session & Sécurité
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Téléversement de fichiers
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp

# Configuration Commerce par défaut
SHOP_CURRENCY=FCFA
SHOP_TIMEZONE=Africa/Douala
SHOP_DEFAULT_THEME=fashion
